        private void btnXoaA_Click(object sender, EventArgs e)
        {
            if (lstLopA.SelectedItems.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn các phần tử cần xóa trong Lớp A.", "Chú ý", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            var hoiXoa = MessageBox.Show("Bạn có chắc xóa những phần tử này?", "Chú ý", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button1);
            if (hoiXoa == DialogResult.Yes)
                xoaDuLieu(lstLopA);
        }

